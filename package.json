{
  "name": "openclaw-plugin-ga4",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "plugin:build": "npm run build && ./scripts/openclaw-sandbox.sh plugins build --entry ./dist/index.js",
    "plugin:check": "npm run build && ./scripts/openclaw-sandbox.sh plugins build --entry ./dist/index.js --check",
    "plugin:validate": "npm run build && ./scripts/openclaw-sandbox.sh plugins validate --entry ./dist/index.js",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "openclaw": "latest",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
