{
  "name": "open-ga4",
  "version": "0.1.0",
  "description": "Open GA4: read-only, privacy-respecting Google Analytics 4 answers for an OpenClaw agent.",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "google-analytics",
    "ga4",
    "analytics",
    "privacy"
  ],
  "license": "MIT-0",
  "author": "Anatoli Iliev <anatoli@helphabit.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatoli-iliev/open-ga4.git"
  },
  "homepage": "https://github.com/anatoli-iliev/open-ga4#readme",
  "bugs": {
    "url": "https://github.com/anatoli-iliev/open-ga4/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "PRIVACY.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "pretest": "npm run build",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "dependencies": {
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "openclaw": "latest",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1"
    },
    "install": {
      "npmSpec": "openclaw-plugin-ga4",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.7.1"
    }
  }
}
